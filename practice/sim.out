#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x559b36a7c490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x559b36a7c620 .scope module, "tb_practice" "tb_practice" 3 1;
 .timescale 0 0;
v0x559b36ac5a70_0 .var "clk", 0 0;
v0x559b36ac5b10_0 .net "out", 0 0, L_0x559b36ac5be0;  1 drivers
S_0x559b36ab57a0 .scope module, "dut" "practice" 3 5, 4 1 0, S_0x559b36a7c620;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /OUTPUT 1 "out";
L_0x559b36ac5be0 .functor BUFZ 1, v0x559b36ac5a70_0, C4<0>, C4<0>, C4<0>;
v0x559b36ab5980_0 .net "clk", 0 0, v0x559b36ac5a70_0;  1 drivers
v0x559b36ac5950_0 .net "out", 0 0, L_0x559b36ac5be0;  alias, 1 drivers
    .scope S_0x559b36a7c620;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x559b36a7c620 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x559b36a7c620;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x559b36ac5a70_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x559b36ac5a70_0;
    %inv;
    %store/vec4 v0x559b36ac5a70_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x559b36a7c620;
T_2 ;
    %delay 100, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_practice.v";
    "practice.v";
