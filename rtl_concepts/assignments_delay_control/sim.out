#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x558ddaae4510 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x558ddaae46a0 .scope module, "code20" "code20" 3 1;
 .timescale 0 0;
v0x558ddaae4830_0 .var "x", 3 0;
v0x558ddab2f360_0 .var "y", 3 0;
v0x558ddab2f440_0 .var "z", 3 0;
E_0x558ddaae4a50 .event "_ivl_0";
    .scope S_0x558ddaae46a0;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x558ddaae4830_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x558ddab2f360_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x558ddab2f440_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x558ddaae46a0;
T_1 ;
    %vpi_call/w 3 6 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x558ddaae46a0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x558ddaae46a0;
T_2 ;
    %wait E_0x558ddaae4a50;
    %jmp T_2;
    .thread T_2;
    .scope S_0x558ddaae46a0;
T_3 ;
    %vpi_call/w 3 26 "$display", "time = %0t | x=%d | y=%d | z=%d", $time, v0x558ddaae4830_0, v0x558ddab2f360_0, v0x558ddab2f440_0 {0 0 0};
    %delay 1, 0;
    %vpi_call/w 3 28 "$display", "time = %0t | x=%d | y=%d | z=%d", $time, v0x558ddaae4830_0, v0x558ddab2f360_0, v0x558ddab2f440_0 {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "code20.v";
