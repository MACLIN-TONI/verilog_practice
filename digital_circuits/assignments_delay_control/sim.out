#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5619f1398510 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5619f13986a0 .scope module, "code20" "code20" 3 1;
 .timescale 0 0;
v0x5619f1398870_0 .var "x", 3 0;
v0x5619f13e48e0_0 .var "y", 3 0;
v0x5619f13e49c0_0 .var "z", 3 0;
E_0x5619f1398a50 .event anyedge, v0x5619f13e48e0_0;
E_0x5619f1398ef0 .event anyedge, v0x5619f1398870_0;
    .scope S_0x5619f13986a0;
T_0 ;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5619f1398870_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5619f13e48e0_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5619f13e49c0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x5619f13986a0;
T_1 ;
    %vpi_call/w 3 6 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5619f13986a0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5619f13986a0;
T_2 ;
    %pushi/vec4 10, 0, 4;
    %assign/vec4 v0x5619f1398870_0, 0;
    %pushi/vec4 15, 0, 4;
    %assign/vec4 v0x5619f13e48e0_0, 0;
    %end;
    .thread T_2;
    .scope S_0x5619f13986a0;
T_3 ;
    %wait E_0x5619f1398ef0;
    %load/vec4 v0x5619f1398870_0;
    %assign/vec4 v0x5619f13e49c0_0, 0;
    %jmp T_3;
    .thread T_3, $push;
    .scope S_0x5619f13986a0;
T_4 ;
    %wait E_0x5619f1398a50;
    %load/vec4 v0x5619f13e48e0_0;
    %assign/vec4 v0x5619f13e49c0_0, 0;
    %jmp T_4;
    .thread T_4, $push;
    .scope S_0x5619f13986a0;
T_5 ;
    %vpi_call/w 3 26 "$display", "time = %0t | x=%d | y=%d | z=%d", $time, v0x5619f1398870_0, v0x5619f13e48e0_0, v0x5619f13e49c0_0 {0 0 0};
    %delay 1, 0;
    %vpi_call/w 3 28 "$display", "time = %0t | x=%d | y=%d | z=%d", $time, v0x5619f1398870_0, v0x5619f13e48e0_0, v0x5619f13e49c0_0 {0 0 0};
    %end;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "code20.v";
