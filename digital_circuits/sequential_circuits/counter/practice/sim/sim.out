    .scope S_0x55bc1c3b73e0;
T_1 ;
    %vpi_call/w 3 14 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55bc1c3b73e0 {0 0 0};
    %end;
