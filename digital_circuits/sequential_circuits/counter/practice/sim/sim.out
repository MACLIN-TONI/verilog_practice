    %pushi/vec4 0, 0, 3;
    %assign/vec4 v0x55bc1c3cb8e0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55bc1c3cb8e0_0;
    %parti/s 1, 1, 2;
    %inv;
