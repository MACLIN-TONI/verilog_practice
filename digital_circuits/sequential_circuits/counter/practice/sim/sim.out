T_3 ;
    %vpi_call/w 3 24 "$monitor", "out = %d", v0x55bc1c3cbbc0_0 {0 0 0};
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55bc1c3cba20_0, 0, 1;
    %delay 150000, 0;
    %vpi_call/w 3 29 "$finish" {0 0 0};
