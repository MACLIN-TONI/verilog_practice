#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55889e05a570 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55889e05a700 .scope module, "code15" "code15" 3 1;
 .timescale 0 0;
v0x55889e081930_0 .var "a", 3 0;
v0x55889e0a42d0_0 .var "b", 3 0;
v0x55889e0a43b0_0 .var "c", 3 0;
E_0x55889e05aa30 .event "_ivl_0";
    .scope S_0x55889e05a700;
T_0 ;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x55889e0a42d0_0, 0, 4;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x55889e0a43b0_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x55889e05a700;
T_1 ;
    %vpi_call/w 3 6 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55889e05a700 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x55889e05a700;
T_2 ;
    %wait E_0x55889e05aa30;
    %jmp T_2;
    .thread T_2;
    .scope S_0x55889e05a700;
T_3 ;
    %delay 100, 0;
    %vpi_call/w 3 20 "$display", $time, " ", v0x55889e081930_0, " ", v0x55889e0a42d0_0, " ", v0x55889e0a43b0_0 {0 0 0};
    %end;
    .thread T_3;
